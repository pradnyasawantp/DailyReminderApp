<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/medicine_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="96dp"
        android:scrollbars="none" />

    <ProgressBar
        android:id="@+id/progressLoader"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/mintStrong"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/no_med_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@color/mint"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/mintStrong"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/noMedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your day is clear"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Create a reminder and let the app keep you on track."
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_med_now"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Create reminder"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/mintStrong"
            app:cornerRadius="26dp" />
    </LinearLayout>
</FrameLayout>